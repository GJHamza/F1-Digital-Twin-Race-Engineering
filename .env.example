# ============================================================
# F1 DIGITAL TWIN — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure environment-specific variables.
# NEVER commit real credentials or secrets to git tracking.
# ============================================================

# Environment & Application Mode
FLASK_ENV=production
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# CORS & Network Security Settings
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://localhost:8501
MAX_CONTENT_LENGTH=1048576

# MongoDB Database Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=F1_Simulation
MONGO_CONNECT_TIMEOUT_MS=1000
MONGO_SOCKET_TIMEOUT_MS=1000

# Apache Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=f1_telemetry
KAFKA_ML_SIGNALS_TOPIC=f1_ml_signals
KAFKA_GROUP_ID=f1-engine-group
KAFKA_TIMEOUT_MS=1000

# MinIO / S3 Object Storage Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=f1-data-lake

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

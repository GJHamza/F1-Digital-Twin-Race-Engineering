# Stage 1: Build React Cockpit Frontend (Partie 4)
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY code/partie4/package*.json ./
RUN npm ci
COPY code/partie4/ ./
RUN npm run build

# Stage 2: Production Flask API Gateway (Partie 1)
FROM python:3.10-slim AS runtime
WORKDIR /app

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_ENV=production \
    FLASK_DEBUG=false \
    HOST=0.0.0.0 \
    PORT=5000 \
    PYTHONPATH=/app/code

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY code/ /app/code/
COPY schema/ /app/schema/

# Copy compiled React cockpit frontend assets from Stage 1 into Flask static directory
COPY --from=frontend-builder /app/frontend/dist/ /app/code/partie1/cockpit/

# Non-root security user
RUN useradd -m -u 1000 f1user && chown -R f1user:f1user /app
USER f1user

EXPOSE 5000

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

CMD ["gunicorn", "--workers", "4", "--bind", "0.0.0.0:5000", "partie1.app:app"]
